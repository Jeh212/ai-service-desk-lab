# =============================================================================
# AI Service Desk Lab — environment configuration
# Copy to .env and adjust. NEVER commit a real .env or real API keys.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# "development" relaxes some guards (demo auth). Never run "production" here
# without a real identity provider.
APP_ENV=development
LOG_LEVEL=INFO
# Structured JSON logs (true) or pretty console logs (false).
LOG_JSON=false

# ---- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# ---- MongoDB ----------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example
MONGO_PORT=27017
MONGO_DB=ai_service_desk
# The backend connects with this URI. When running the API on the host and
# Mongo in Docker, "localhost" is correct. Inside docker-compose use "mongodb".
MONGO_URI=mongodb://root:example@localhost:27017/?authSource=admin
MONGO_EXPRESS_PORT=8081

# ---- LLM provider -----------------------------------------------------------
# "mock"  -> deterministic, offline, no API key required (default for tests).
# "groq"  -> real GroqCloud provider (requires GROQ_API_KEY).
LLM_PROVIDER=mock

# ---- Groq (real provider) ---------------------------------------------------
# Get a key at https://console.groq.com/keys . Keep it secret.
GROQ_API_KEY=
# Fast general chat/tool-calling model. Verify availability in the Groq docs.
GROQ_MODEL=llama-3.1-8b-instant
# Model used for strict JSON/structured-output experiments only.
GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b

# ---- Shared LLM tuning ------------------------------------------------------
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ITERATIONS=5
# Max conversation turns sent to the model (token economy for small quotas).
LLM_HISTORY_WINDOW=10
# Limited exponential-backoff retries on 429 / transient errors.
LLM_MAX_RETRIES=2

# ---- Evaluation -------------------------------------------------------------
# Concurrency cap so real-provider eval runs respect the Groq quota.
EVAL_CONCURRENCY=2

# ---- Demo authentication ----------------------------------------------------
# Signing secret for the demo session tokens. Replace in any shared setting.
DEMO_AUTH_SECRET=change-me-dev-only-secret
# Demo session lifetime (minutes).
DEMO_SESSION_TTL_MINUTES=720
